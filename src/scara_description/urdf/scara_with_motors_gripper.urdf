  <collision><origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://scara_description/meshes/aligned/j2_coupler.stl" scale="0.001 0.001 0.001" /></geometry>
      </collision></link>
  <joint name="joint2" type="revolute">
    <parent link="arm1_link" /><child link="j2_link" />
    <origin xyz="0.218367 0.065575 -0.035004" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="-3.14159" upper="3.14159" effort="10" velocity="1.5" />
  </joint>

  
  <link name="arm2_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://scara_description/meshes/aligned/arm2.stl" scale="0.001 0.001 0.001" /></geometry>
