    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://scara_description/meshes/aligned/gripper_slider_right.stl" scale="0.001 0.001 0.001" /></geometry>
    </collision>
  </link>
  <link name="gripper_link1_left">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://scara_description/meshes/aligned/gripper_link1_left.stl" scale="0.001 0.001 0.001" /></geometry>
      <material name="white" />
