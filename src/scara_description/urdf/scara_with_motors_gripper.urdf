      <geometry><mesh filename="package://scara_description/meshes/aligned/j3_coupler.stl" scale="0.001 0.001 0.001" /></geometry>
      </collision></link>
  <joint name="joint3" type="revolute">
    <parent link="arm2_link" /><child link="j3_link" />
    <origin xyz="0.106764 -0.085051 -0.057000" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="-3.14159" upper="3.14159" effort="5" velocity="2" />
  </joint>

  
  <link name="gripper_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://scara_description/meshes/aligned/gripper_static_nomech.stl" scale="0.001 0.001 0.001" /></geometry>
      <material name="white" />
    </visual>
  <collision><origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://scara_description/meshes/aligned/gripper_static_nomech.stl" scale="0.001 0.001 0.001" /></geometry>
      </collision></link>
  <joint name="j3_to_gripper" type="fixed">
    <parent link="j3_link" /><child link="gripper_link" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>

  
  <link name="gripper_left">
    
    <visual>
      <origin xyz="0.000000 0.000000 0.100000" rpy="3.14159265 0 0" />
      <geometry><mesh filename="package://scara_description/meshes/gripper/Gripper_Hand_Left.STL" scale="0.001 0.001 0.001" /></geometry>
      <material name="white" />
    </visual>
    <visual>
      <origin xyz="0.000000 0.026000 0.100000" rpy="3.14159265 0 0" />
      <geometry><mesh filename="package://scara_description/meshes/gripper/Gripper_Hand_Left.STL" scale="0.001 0.001 0.001" /></geometry>
      <material name="white" />
    </visual>
    <visual>
      <origin xyz="0.001488 0.026469 -0.004535" rpy="0 0 -1.5712" />
      <geometry><mesh filename="package://scara_description/meshes/gripper/Gripper_End.STL" scale="0.001 0.001 0.001" /></geometry>
      <material name="white" />
    </visual>
  <collision><origin xyz="0.000000 0.000000 0.100000" rpy="3.14159265 0 0" />
      <geometry><mesh filename="package://scara_description/meshes/gripper/Gripper_Hand_Left.STL" scale="0.001 0.001 0.001" /></geometry>
      </collision><collision><origin xyz="0.000000 0.026000 0.100000" rpy="3.14159265 0 0" />
      <geometry><mesh filename="package://scara_description/meshes/gripper/Gripper_Hand_Left.STL" scale="0.001 0.001 0.001" /></geometry>
      </collision><collision><origin xyz="0.001488 0.026469 -0.004535" rpy="0 0 -1.5712" />
      <geometry><mesh filename="package://scara_description/meshes/gripper/Gripper_End.STL" scale="0.001 0.001 0.001" /></geometry>
      </collision></link>
  <joint name="gripper_left_joint" type="prismatic">
    <parent link="gripper_link" /><child link="gripper_left" />
    <origin xyz="-0.052913 -0.020971 -0.109899" rpy="0 0 0.1487" />
    <axis xyz="1 0 0" />
    <limit lower="0" upper="0.014" effort="20" velocity="0.05" />
  </joint>

  
  <link name="gripper_right">
    
    
    <visual>
      <origin xyz="0.000000 0.000000 0.100000" rpy="3.14159265 0 0" />
