    <origin xyz="0.030993 -0.008579 -0.108696" rpy="0 0 0.1462" />
    <axis xyz="-1 0 0" />
    <limit lower="0" upper="0.014" effort="20" velocity="0.05" />
    <mimic joint="gripper_left_joint" multiplier="1" offset="0" />
  </joint>

<link name="tcp_link" /><joint name="gripper_to_tcp" type="fixed"><parent link="gripper_link" /><child link="tcp_link" /><origin xyz="0 0 -0.109899" rpy="0 0 0" /></joint>
  <!-- ===== NEMA 17 stepper motors =====
       Mesh frame: origin on shaft axis, z=0 on mounting face, body toward -Z (40 mm), shaft toward +Z (20 mm).
       Positions/yaw measured from pilot holes and 31 mm bolt patterns in the aligned STLs. -->
  <material name="motor_black"><color rgba="0.12 0.12 0.12 1" /></material>

  <!-- Base-rotation motor: in the diamond pocket of the base block (floor z=37 mm), shaft down through pilot hole -->
  <link name="motor_j1_base">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://scara_description/meshes/aligned/nema17.stl" scale="0.001 0.001 0.001" /></geometry>
      <material name="motor_black" />
    </visual>
    <collision>
      <origin xyz="0 0 -0.020" rpy="0 0 0" />
      <geometry><box size="0.042 0.042 0.040" /></geometry>
    </collision>
  </link>
  <joint name="motor_j1_base_mount" type="fixed">
    <parent link="base_link" /><child link="motor_j1_base" />
    <origin xyz="0.0371 0.1034 0.0370" rpy="3.141593 0.000000 0.7854" />
  </joint>

  <!-- Z-axis motor: on top face of z_top_plate (z=468 mm), shaft down through pilot hole -->
  <link name="motor_z">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://scara_description/meshes/aligned/nema17.stl" scale="0.001 0.001 0.001" /></geometry>
      <material name="motor_black" />
    </visual>
    <collision>
      <origin xyz="0 0 -0.020" rpy="0 0 0" />
      <geometry><box size="0.042 0.042 0.040" /></geometry>
    </collision>
  </link>
  <joint name="motor_z_mount" type="fixed">
    <parent link="base_rotation_link" /><child link="motor_z" />
    <origin xyz="0.0316 0.0095 0.4680" rpy="3.141593 0.000000 0.2985" />
  </joint>

  <!-- Carriage motor: on top face of z_mount_platform, shaft down through pilot hole; moves with z_axis -->
  <link name="motor_j2_carriage">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://scara_description/meshes/aligned/nema17.stl" scale="0.001 0.001 0.001" /></geometry>
      <material name="motor_black" />
    </visual>
    <collision>
      <origin xyz="0 0 -0.020" rpy="0 0 0" />
      <geometry><box size="0.042 0.042 0.040" /></geometry>
    </collision>
  </link>
  <joint name="motor_j2_carriage_mount" type="fixed">
    <parent link="z_mount_platform" /><child link="motor_j2_carriage" />
    <origin xyz="-0.0096 -0.0029 0.0000" rpy="3.141593 0.000000 0.2915" />
  </joint>

  <!-- J3 motor: on underside of arm2 (z=-39 mm), shaft up through pilot hole -->
  <link name="motor_j3_arm2">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://scara_description/meshes/aligned/nema17.stl" scale="0.001 0.001 0.001" /></geometry>
      <material name="motor_black" />
    </visual>
    <collision>
      <origin xyz="0 0 -0.020" rpy="0 0 0" />
      <geometry><box size="0.042 0.042 0.040" /></geometry>
    </collision>
  </link>
  <joint name="motor_j3_arm2_mount" type="fixed">
    <parent link="arm2_link" /><child link="motor_j3_arm2" />
    <origin xyz="-0.0047 0.0037 -0.0390" rpy="0.000000 0.000000 -0.6737" />
  </joint>


  <!-- ===== Gripper linkage: servo horn drives 2 links per side; each link pair pins to a slider that rides with its finger ===== -->
  <link name="gripper_horn">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://scara_description/meshes/aligned/gripper_horn.stl" scale="0.001 0.001 0.001" /></geometry>
      <material name="white" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://scara_description/meshes/aligned/gripper_horn.stl" scale="0.001 0.001 0.001" /></geometry>
    </collision>
  </link>
  <link name="gripper_slider_left">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://scara_description/meshes/aligned/gripper_slider_left.stl" scale="0.001 0.001 0.001" /></geometry>
