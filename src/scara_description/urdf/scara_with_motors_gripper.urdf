  <link name="gripper_link2_right">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://scara_description/meshes/aligned/gripper_link2_right.stl" scale="0.001 0.001 0.001" /></geometry>
      <material name="white" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://scara_description/meshes/aligned/gripper_link2_right.stl" scale="0.001 0.001 0.001" /></geometry>
    </collision>
  </link>
  <joint name="gripper_horn_joint" type="revolute">
    <parent link="gripper_link" /><child link="gripper_horn" />
    <origin xyz="0.000194 -0.001250 -0.039498" rpy="0.000000 -0.000000 0.000000" />
    <axis xyz="-0.144501 0.989505 0.000000" />
    <limit lower="-3.14159" upper="3.14159" effort="5" velocity="2" />
