    </visual>
  <collision><origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://scara_description/meshes/aligned/z_rods.stl" scale="0.001 0.001 0.001" /></geometry>
      </collision></link>
  <joint name="base_to_z_rods" type="fixed">
    <parent link="base_rotation_link" /><child link="z_rods" />
    <origin xyz="-0.150 -0.070 0" rpy="0 0 0" />
  </joint>

