<?xml version='1.0' encoding='UTF-8'?>
<robot name="scara_robot">

  <material name="blue"><color rgba="0.10 0.45 0.90 1" /></material>
  <material name="white"><color rgba="0.90 0.90 0.90 1" /></material>
  <material name="metal"><color rgba="0.65 0.65 0.65 1" /></material>

  

  
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://scara_description/meshes/aligned/base.stl" scale="0.001 0.001 0.001" /></geometry>
      <material name="blue" />
    </visual>
  <collision><origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://scara_description/meshes/aligned/base.stl" scale="0.001 0.001 0.001" /></geometry>
      </collision></link>

  
  <link name="base_rotation_link" />
  <joint name="base_joint" type="revolute">
    <parent link="base_link" /><child link="base_rotation_link" />
    <origin xyz="0.150 0.070 0" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="-3.14159" upper="3.14159" effort="10" velocity="1.0" />
  </joint>

  
  <link name="z_bottom_plate">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://scara_description/meshes/aligned/z_bottom_plate.stl" scale="0.001 0.001 0.001" /></geometry>
      <material name="blue" />
    </visual>
  <collision><origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://scara_description/meshes/aligned/z_bottom_plate.stl" scale="0.001 0.001 0.001" /></geometry>
      </collision></link>
  <joint name="base_to_z_bottom" type="fixed">
    <parent link="base_rotation_link" /><child link="z_bottom_plate" />
    <origin xyz="-0.150 -0.070 0" rpy="0 0 0" />
  </joint>

  <link name="z_rods">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://scara_description/meshes/aligned/z_rods.stl" scale="0.001 0.001 0.001" /></geometry>
