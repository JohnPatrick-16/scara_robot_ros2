  <collision><origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://scara_description/meshes/aligned/z_drive_coupler.stl" scale="0.001 0.001 0.001" /></geometry>
      </collision></link>
  <joint name="base_to_z_drive_coupler" type="fixed">
    <parent link="base_rotation_link" /><child link="z_drive_coupler" />
    <origin xyz="-0.150 -0.070 0" rpy="0 0 0" />
  </joint>

  
  <link name="z_mount_platform">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://scara_description/meshes/aligned/z_mount_platform.stl" scale="0.001 0.001 0.001" /></geometry>
      <material name="blue" />
    </visual>
  <collision><origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://scara_description/meshes/aligned/z_mount_platform.stl" scale="0.001 0.001 0.001" /></geometry>
      </collision></link>
  <joint name="z_axis" type="prismatic">
    <parent link="base_rotation_link" /><child link="z_mount_platform" />
    <origin xyz="0 0 0.308616" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="-0.175" upper="0.09" effort="10" velocity="0.05" />
  </joint>

  
  <link name="j1_link" />
  <joint name="joint1" type="fixed">
    <parent link="z_mount_platform" /><child link="j1_link" />
    <origin xyz="0 0 -0.028996" rpy="0 0 0" />
  </joint>

  <link name="arm1_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://scara_description/meshes/aligned/arm1.stl" scale="0.001 0.001 0.001" /></geometry>
